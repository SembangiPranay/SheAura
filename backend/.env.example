# SheAura Secure Backend Environment Variables
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:6080,http://localhost:8443,http://localhost:5173

# Database & Supabase (Keep Service Key PRIVATE, Never expose to client)
SUPABASE_URL=https://erxquucmoonszopopavx.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Payment Gateways (Server-side HMAC verification)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Admin Authorization
ADMIN_SECRET_KEY=generate_a_secure_random_key_here
